roadwatch-backend/models/*.csv          # training logs
roadwatch-backend/models/*_saved/       # tf2onnx temp folder
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

