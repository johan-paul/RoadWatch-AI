<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext (HTTP) traffic to any host during development.
  Replace with specific domain rules before releasing to production.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
