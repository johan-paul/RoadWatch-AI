# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Settings → Database → URI)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres

# ── Firebase ───────────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=RoadWatch AI
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Supabase Storage buckets (create these in Supabase dashboard) ──
STORAGE_BUCKET_COMPLAINTS=complaint-images
STORAGE_BUCKET_REPAIRS=repair-images
STORAGE_BUCKET_AVATARS=avatars

# ── Admin web dashboard ─────────────────────────────────────────────
# The admin enters this secret on the web dashboard login page
ADMIN_SECRET=change-this-to-something-strong

# ── AI Model ────────────────────────────────────────────────
AI_MODEL_PATH=models/road_damage.keras
AI_CONFIDENCE_THRESHOLD=0.40
